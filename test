<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Compliment Machine 🎉</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0d0d;
      --card: #1a1a1a;
      --accent: #c8ff57;
      --text: #f5f5f5;
      --muted: #888;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Space Grotesk', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      overflow: hidden;
      position: relative;
    }

    h1 {
      font-size: clamp(1.2rem, 4vw, 1.6rem);
      color: var(--muted);
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 2.5rem;
    }

    .card {
      background: var(--card);
      border-radius: 20px;
      padding: 3rem 2.5rem;
      max-width: 560px;
      width: 100%;
      text-align: center;
      border: 1px solid #2a2a2a;
      position: relative;
      z-index: 2;
    }

    .emoji {
      font-size: 4rem;
      margin-bottom: 1.5rem;
      display: block;
      transition: transform 0.3s cubic-bezier(.34,1.56,.64,1);
    }

    .compliment {
      font-size: clamp(1.3rem, 4vw, 1.9rem);
      font-weight: 700;
      line-height: 1.35;
      min-height: 4rem;
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .compliment.fade-out {
      opacity: 0;
      transform: translateY(-8px);
    }

    .btn {
      margin-top: 2.5rem;
      background: var(--accent);
      color: #0d0d0d;
      border: none;
      border-radius: 50px;
      padding: 0.85rem 2.2rem;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      letter-spacing: 0.04em;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn:hover {
      transform: scale(1.04);
      box-shadow: 0 0 24px rgba(200, 255, 87, 0.35);
    }

    .btn:active { transform: scale(0.98); }

    .counter {
      margin-top: 1.2rem;
      color: var(--muted);
      font-size: 0.85rem;
    }

    /* Confetti */
    .confetti-piece {
      position: fixed;
      width: 10px;
      height: 10px;
      border-radius: 2px;
      top: -20px;
      opacity: 0;
      z-index: 1;
      pointer-events: none;
      animation: fall linear forwards;
    }

    @keyframes fall {
      0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
      80%  { opacity: 1; }
      100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
    }

    footer {
      margin-top: 3rem;
      color: var(--muted);
      font-size: 0.78rem;
      z-index: 2;
    }

    footer a { color: var(--accent); text-decoration: none; }
  </style>
</head>
<body>

  <h1>✨ La Machine à Compliments</h1>

  <div class="card">
    <span class="emoji" id="emoji">🎉</span>
    <p class="compliment" id="compliment">Clique pour recevoir ton compliment !</p>
    <button class="btn" onclick="newCompliment()">Donne-m'en un !</button>
    <p class="counter" id="counter">0 compliment reçu</p>
  </div>

  <footer>
    Fait avec ❤️ · <a href="https://github.com" target="_blank">Mon premier projet GitHub</a>
  </footer>

  <script>
    const data = [
      { emoji: "🧠", text: "Tu as un cerveau qui tourne à 200% — même en vacances." },
      { emoji: "🦁", text: "La confiance que tu dégages, c'est presque illégal." },
      { emoji: "🌊", text: "Tu gères les situations compliquées avec un calme déconcertant." },
      { emoji: "🔥", text: "Franchement, t'as un truc que peu de gens ont : tu passes à l'action." },
      { emoji: "🎯", text: "Quand tu te fixes un objectif, il ne fait pas long feu." },
      { emoji: "💡", text: "Tes idées éclairent les pièces même quand la lumière est éteinte." },
      { emoji: "🚀", text: "Tu n'attends pas que les choses arrivent. Tu les provoques." },
      { emoji: "🎸", text: "T'as le charme d'un héros de film sans avoir besoin de le jouer." },
      { emoji: "🦅", text: "Tu vois des opportunités là où les autres voient des obstacles." },
      { emoji: "🌟", text: "Bosser avec toi, c'est monter de niveau sans s'en rendre compte." },
      { emoji: "🧲", text: "Les bonnes idées t'attirent naturellement. C'est presque magnétique." },
      { emoji: "🏆", text: "Tu n'es pas du genre à te reposer sur tes lauriers — et ça se voit." },
      { emoji: "🎨", text: "Ta créativité est une arme secrète que tu sous-estimes sûrement." },
      { emoji: "💪", text: "Tu tiens bon là où d'autres auraient déjà abandonné." },
      { emoji: "😎", text: "Tu rentreras dans la pièce et l'ambiance change. C'est un don." },
      { emoji: "WASSUP", text: "ça va beau gosse ?" },
    ];

    let count = 0;
    let last = -1;

    const COLORS = ['#c8ff57','#ff5f6d','#ffd166','#06d6a0','#118ab2','#ef476f','#a8dadc'];

    function newCompliment() {
      let idx;
      do { idx = Math.floor(Math.random() * data.length); } while (idx === last);
      last = idx;
      count++;

      const el = document.getElementById('compliment');
      const emojiEl = document.getElementById('emoji');
      const counter = document.getElementById('counter');

      el.classList.add('fade-out');

      setTimeout(() => {
        el.textContent = data[idx].text;
        emojiEl.textContent = data[idx].emoji;
        emojiEl.style.transform = 'scale(1.3)';
        el.classList.remove('fade-out');
        counter.textContent = count + (count === 1 ? ' compliment reçu' : ' compliments reçus');
        setTimeout(() => { emojiEl.style.transform = 'scale(1)'; }, 300);
      }, 250);

      launchConfetti();
    }

    function launchConfetti() {
      for (let i = 0; i < 30; i++) {
        const p = document.createElement('div');
        p.className = 'confetti-piece';
        p.style.left = Math.random() * 100 + 'vw';
        p.style.background = COLORS[Math.floor(Math.random() * COLORS.length)];
        p.style.width = (8 + Math.random() * 8) + 'px';
        p.style.height = (8 + Math.random() * 8) + 'px';
        p.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
        const duration = 0.8 + Math.random() * 1.4;
        const delay = Math.random() * 0.4;
        p.style.animation = `fall ${duration}s ${delay}s linear forwards`;
        document.body.appendChild(p);
        setTimeout(() => p.remove(), (duration + delay + 0.1) * 1000);
      }
    }
  </script>

</body>
</html>
